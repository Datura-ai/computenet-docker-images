# What the boot smoke needs to get past the entrypoint's own guards. Not a runtime config:
# prod passes these from the filler template row.
#
# The key only has to be non-empty — the entrypoint refuses to start without one, and refusing
# is the behaviour we want on a real node.
DOLPHIN_API_KEY=dp-smoke
# The worker binary comes from updates.dphn.ai in prod. The smoke must not depend on Dolphin's
# CDN, so it hands the entrypoint a local file instead: curl reads file:// like any other URL,
# and /bin/true is an executable that exits 0 the way a worker that finished would.
DOLPHIN_WORKER_URL=file:///bin/true
