# What the E2E_GPU=1 boot smoke needs to get past the entrypoint's own guards. Not a runtime config:
# prod passes these from the filler template row. Read only on a GPU host — on the CPU runner the
# boot is skipped (smoke.gpu).
#
# The wallet only has to be non-empty — the entrypoint refuses to start without one, and refusing
# is the behaviour we want on a real node. It is never sent to a real pool: the pool is the
# container's own loopback on a closed port, so PeakMiner fails to connect and the supervisor
# restarts it while the smoke reads nvidia-smi inside the container.
PEARL_POOL_WALLET=smoke
PEARL_POOL_HOST=127.0.0.1
PEARL_POOL_PORT=1
# no release-list call to GitHub from the smoke
PEARL_MINER_AUTO_UPDATE=0
